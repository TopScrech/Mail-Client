ORIGIN=http://localhost:5173
RP_ID=localhost
DATABASE_PATH=./data/mail-otter.sqlite
# Generate with: bun -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
ENCRYPTION_KEY=
# Apple requires an HTTPS domain and this exact Return URL:
# https://your-domain/api/v1/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the .p8 key with literal \n separators
APPLE_PRIVATE_KEY=
# Comma-separated exact hostnames approved by the server operator
MAIL_ALLOWED_HOSTS=imap.mail.me.com,smtp.mail.me.com,imap.gmail.com,smtp.gmail.com,imap.fastmail.com,smtp.fastmail.com,outlook.office365.com,smtp.office365.com
# Set true only when your non-Gmail SMTP server automatically stores sent messages
SMTP_SAVES_SENT=false
# adapter-node request limit (attachments max 15 MB plus multipart overhead)
BODY_SIZE_LIMIT=16777216
# Mailbox OAuth credentials (runtime only)
# Redirect: <ORIGIN>/api/v1/mail/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect: <ORIGIN>/api/v1/mail/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
